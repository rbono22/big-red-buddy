# Development only; actual .env is ignored. Never publish localhost through a tunnel with dev sign-in.
APP_ORIGIN=http://127.0.0.1:4318
HOST=127.0.0.1
PORT=4318
DEV_AUTH_EMAILS=
ADMIN_EMAILS=
# Use separate non-superuser PostgreSQL roles; see deploy/PILOT.md for provisioning.
DATABASE_URL=
WORKER_DATABASE_URL=
DATA_ENCRYPTION_KEY=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Fixed sign-in domain. Other or additional domains are rejected.
ALLOWED_GOOGLE_DOMAINS=cornell.edu
# Exact invited Cornell addresses; keep the existing pilot membership unchanged.
PILOT_EMAILS=
# Optional private approval sheet. The owner must also be in PILOT_EMAILS.
PILOT_SHEET_ID=
PILOT_SHEET_OWNER=
PILOT_SHEET_GID=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=dabas_class_bot
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_ALLOWED_TEAM_IDS=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
# Local PDF conversion uses .venv-markitdown/bin/python by default. See README setup.
# Override only with an absolute path to the installed Python environment.
MARKITDOWN_PYTHON=
# Set false to recover with Poppler-only PDF extraction; image/scanned-page OCR stays local.
MARKITDOWN_ENABLED=true
WORKER_CONCURRENCY=1
REMINDER_CONCURRENCY=2
MONTHLY_INFRA_COST_USD=
# Optional operator-only class-demo import; each target must already have signed in.
IMPORT_STUDENT_EMAIL=
EXPORT_STUDENT_EMAIL=
SYLLABUS_PDF_PATH=
RESUME_PDF_PATH=

# Supported hosted application forms: enable on web and model workers after browser checks.
APPLICATION_BROWSER_ENABLED=false
# Defaults to Google Chrome on macOS; set an absolute executable path elsewhere.
# APPLICATION_BROWSER_PATH=/path/to/chrome
