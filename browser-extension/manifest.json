{
  "manifest_version": 3,
  "name": "Big Red Buddy - Application Helper",
  "version": "0.1.0",
  "description": "Fill a BRB application in your own browser. You finish and submit on the employer website.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://app.bigredbuddy.com/*",
    "https://jobs.lever.co/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*"
  ],
  "action": {"default_title": "Fill with Big Red Buddy", "default_popup": "popup.html"},
  "background": {"service_worker": "background.mjs", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
