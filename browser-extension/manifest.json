{
  "manifest_version": 3,
  "name": "Big Red Buddy - Application Helper",
  "version": "0.3.0",
  "description": "Tailor your r\u00e9sum\u00e9 and autofill applications from employer pages, BRB, or Telegram.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.bigredbuddy.com/*",
    "https://jobs.lever.co/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*"
  ],
  "action": {
    "default_title": "Fill with Big Red Buddy",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.bigredbuddy.com/*"
      ],
      "js": [
        "brb-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "minimum_chrome_version": "106"
}
