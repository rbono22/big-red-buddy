# Copy to deploy/pilot.env. This file contains configuration only, not secrets.
APP_DOMAIN=assistant.example.edu
APP_ORIGIN=https://assistant.example.edu
ACME_EMAIL=operator@example.edu
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
# Fixed sign-in domain; Compose and the application both enforce cornell.edu.
ALLOWED_GOOGLE_DOMAINS=cornell.edu
# Replace only with the explicitly invited Cornell pilot members. Do not broaden.
PILOT_EMAILS=student@cornell.edu
# Optional owner-authorized private approval sheet; see docs/pilot-sheet.md.
PILOT_SHEET_ID=
PILOT_SHEET_OWNER=
PILOT_SHEET_GID=0
ADMIN_EMAILS=operator@cornell.edu
MONTHLY_INFRA_COST_USD=
TELEGRAM_BOT_USERNAME=dabas_class_bot
SLACK_CLIENT_ID=
SLACK_ALLOWED_TEAM_IDS=
# Private VPN or VPC address on the always-on model host. Never use public Ollama.
OLLAMA_URL=http://10.77.0.2:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
WORKER_CONCURRENCY=1
REMINDER_CONCURRENCY=2
DISCOVERY_CONCURRENCY=1
WEB_MEMORY=512m
WORKER_MEMORY=1g
POSTGRES_MEMORY=1g
WEB_CPUS=1.0
WORKER_CPUS=1.0
POSTGRES_CPUS=1.0
# Patch tags simplify the first dry run; pin all three to tested @sha256 digests
# before admitting real students. Keep patched versions under review.
NODE_IMAGE=node:24-bookworm-slim
CADDY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:17-bookworm
