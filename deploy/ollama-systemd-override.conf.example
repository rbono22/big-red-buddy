# On the model host: sudo systemctl edit ollama
# Replace 10.77.0.2 with its private VPC/WireGuard IP; allow TCP11434 only from
# the application host. Never bind the model to a public interface.
[Service]
Environment="OLLAMA_HOST=10.77.0.2:11434"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_MAX_QUEUE=8"
Environment="OLLAMA_CONTEXT_LENGTH=16384"
Environment="OLLAMA_NO_CLOUD=1"
